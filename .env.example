# Database
DATABASE_URL=postgresql://postgres:postgres@localhost/shams_development
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Rails
RAILS_ENV=development
RAILS_MAX_THREADS=3
WEB_CONCURRENCY=0
PORT=3001

# macOS fork safety (prevents Puma cluster crash on Apple Silicon)
OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# App
APP_HOST=localhost:3001
ALLOWED_ORIGINS=http://localhost:3001

# LLM Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434
# Google = Gemini through its OpenAI-compatible endpoint. This ENV key is only a
# fallback: Agent#api_key prefers the key saved on Settings > Integrations, then
# Rails credentials, then this value. Override GOOGLE_BASE_URL only if you proxy it.
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/v1

# Bonsai local servers - weights + runtime live in the bonsai227b checkout that
# sits next to this app; bin/run-bonsai finds it on its own (set BONSAI_DIR only
# if your toolkit lives elsewhere).
# One-time setup: cd "$BONSAI_DIR" && BONSAI_OPENWEBUI=0 BONSAI_CODE_INTERPRETER=0 ./setup.sh
# Ternary Bonsai 2 27B (~7.8GB PQ2_0): bin/run-bonsai       -> :8080
BONSAI2_BASE_URL=http://127.0.0.1:8080/v1
# 1-bit Bonsai 27B (~3.9GB):           bin/run-bonsai 1bit  -> :8910
BONSAI_BASE_URL=http://127.0.0.1:8910/v1
# Canonical model id sent to the Bonsai server; bonsai agents normalize any
# stale/foreign label (e.g. claude-sonnet-4-6) to this value. This is the OpenAI
# request id only - NOT the weights-size knob (27B/9B/4B/...) that
# bonsai227b/scripts/start_llama_server.sh reads; bin/run-bonsai pins its own
# family + size, so this value never reaches the launcher.
# Launcher-side knobs, read by bin/run-bonsai rather than the app: BONSAI_DIR
# (toolkit checkout), BONSAI_PORT (8080 / 8910 - never PORT, which bin/dev
# owns), BONSAI_FAMILY (bonsai2 | bonsai | ternary) and BONSAI_CTX.
BONSAI_MODEL=bonsai-2-27b
BONSAI_API_KEY=local

# opencode.ai/zen proxy (OpenAI-compatible, free models)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
LLM_MODEL=deepseek-v4-flash-free

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Email
POSTMARK_API_TOKEN=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sentry
SENTRY_DSN=

# Storage (S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
