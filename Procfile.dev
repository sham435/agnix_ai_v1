web: bin/rails server -p 3001
css: bin/rails tailwindcss:watch
jobs: bin/jobs
# The local model server (OpenAI-compatible llama.cpp on :8080, used by the
# bonsai-* providers) is intentionally NOT a Procfile process: foreman shuts the
# whole stack down as soon as any process exits, and the launcher exits 1 when
# :8080 is already serving /health. Start it in its own terminal instead:
#   bin/run-bonsai              (add "1bit" for the 1-bit server on :8910)
