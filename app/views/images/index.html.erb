<%# Phase 3d — /images gallery. App-shell page (sidebar + scrolling main).
    Composer is pinned to image mode with minimal model/size/quality selectors;
    the grid below is the live Turbo Stream surface: optimistic cards prepend
    on create, Images::GenerateJob replaces cards by DOM id on completion.
    Chat-generated images land here too — same table, same stream. %>
<%= turbo_stream_from "image_generations" %>

<header class="sticky top-0 z-20 flex h-[64px] items-center justify-between gap-3 border-b border-border bg-sidebar/80 glass px-4">
  <div class="flex items-center gap-2 min-w-0">
    <button id="menuBtn" class="lg:hidden grid size-9 place-items-center rounded-xl bg-hover hover:bg-border text-fg-muted" aria-label="Open navigation menu">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <h1 class="text-[16px] font-semibold text-fg truncate">Images</h1>
    <span class="text-[12px] text-fg-subtle">· <%= @pagy.count %> generation<%= "s" unless @pagy.count == 1 %></span>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <span class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">Image mode</span>
  </div>
</header>

<main class="flex-1 overflow-y-auto">
  <div class="mx-auto max-w-[1100px] px-4 sm:px-6 py-6 space-y-5">

    <%# ── Composer (pinned to image mode) ────────────────────────────────── %>
    <%= form_with scope: :image_generation, url: images_path, class: "rounded-2xl border border-border bg-panel/70 p-3 sm:p-4 focus-within:border-emerald-500/40 transition" do |f| %>
      <%= f.text_area :prompt,
            placeholder: "Describe an image to generate…",
            rows: 2,
            class: "w-full resize-none bg-transparent text-[14px] leading-6 text-fg placeholder:text-fg-subtle focus:outline-none",
            required: true,
            maxlength: 2000 %>
      <div class="mt-3 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-3">
        <div class="flex flex-wrap items-center gap-2">
          <%= f.select :model, [["gpt-image-1", "gpt-image-1"], ["DALL·E 3", "dall-e-3"]],
                {}, class: "rounded-lg border border-border bg-elevated px-2 py-1.5 text-[12px] text-fg-muted focus:outline-none focus:border-emerald-500/50" %>
          <%= f.select :size, [["Square 1024×1024", "1024x1024"], ["Portrait 1024×1536", "1024x1536"], ["Landscape 1536×1024", "1536x1024"]],
                {}, class: "rounded-lg border border-border bg-elevated px-2 py-1.5 text-[12px] text-fg-muted focus:outline-none focus:border-emerald-500/50" %>
          <%= f.select :quality, [["Auto quality", "auto"], ["Low", "low"], ["Medium", "medium"], ["High", "high"]],
                {}, class: "rounded-lg border border-border bg-elevated px-2 py-1.5 text-[12px] text-fg-muted focus:outline-none focus:border-emerald-500/50" %>
        </div>
        <%= f.submit "Generate",
              class: "inline-flex items-center gap-1.5 rounded-xl bg-accent px-4 py-2 text-[13px] font-semibold text-accent-fg hover:brightness-110 active:scale-[0.98] transition cursor-pointer" %>
      </div>
    <% end %>
    <div id="image-form-error" class="-mt-3"></div>

    <%# ── Grid ───────────────────────────────────────────────────────────── %>
    <div id="images-grid" class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 xl:grid-cols-4">
      <% if @image_generations.any? %>
        <%= render partial: "images/card", collection: @image_generations, as: :generation, cached: false %>
      <% else %>
        <div id="images-empty" class="col-span-full rounded-2xl border border-dashed border-border bg-panel/40 px-6 py-14 text-center">
          <div class="mx-auto mb-4 grid size-14 place-items-center rounded-2xl bg-hover text-fg-muted">
            <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg>
          </div>
          <h2 class="text-[16px] font-semibold text-fg">No images yet</h2>
          <p class="mx-auto mt-1.5 max-w-md text-[13.5px] text-fg-muted">
            Generate one above, or ask your agent for an image in any chat — everything shows up here.
          </p>
        </div>
      <% end %>
    </div>

    <%# ── Pagination (Pagy, 24/page) ─────────────────────────────────────── %>
    <% if @pagy.pages > 1 %>
      <nav class="flex items-center justify-center gap-3 pt-1" aria-label="Pages">
        <% if @pagy.prev %>
          <%= link_to "← Previous", images_path(page: @pagy.prev), class: "rounded-xl border border-border bg-panel px-3.5 py-2 text-[13px] text-fg-muted hover:bg-hover hover:text-fg transition" %>
        <% end %>
        <span class="text-[12.5px] text-fg-subtle">Page <%= @pagy.page %> of <%= @pagy.pages %></span>
        <% if @pagy.next %>
          <%= link_to "Next →", images_path(page: @pagy.next), class: "rounded-xl border border-border bg-panel px-3.5 py-2 text-[13px] text-fg-muted hover:bg-hover hover:text-fg transition" %>
        <% end %>
      </nav>
    <% end %>
  </div>
</main>
