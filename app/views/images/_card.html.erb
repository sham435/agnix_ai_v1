<%# One gallery tile. The DOM id is the stable Turbo Stream target shared by
    the optimistic create response and Images::GenerateJob's replace broadcast
    (queued/running skeleton -> succeeded image | failed card). Token-driven
    classes only, so the card is coherent in both themes. Hover/focus actions:
    download · regenerate · delete; clicking the image enlarges it inside the
    top-level "modal" turbo frame. %>
<div id="image-generation-<%= generation.id %>"
     class="group relative overflow-hidden rounded-2xl border border-border bg-panel/60 transition hover:border-emerald-500/40">

  <% if generation.succeeded? && generation.asset.present? %>
    <%= link_to image_path(generation), data: { turbo_frame: "modal" }, class: "block", aria: { label: "Enlarge generated image" } do %>
      <img src="<%= download_image_path(generation) %>"
           alt="<%= generation.prompt.truncate(80) %>"
           loading="lazy"
           class="aspect-square w-full bg-elevated object-cover" />
    <% end %>

    <div class="pointer-events-none absolute inset-x-0 top-0 flex items-start justify-end gap-1 p-2 opacity-0 transition group-hover:opacity-100 group-focus-within:opacity-100">
      <div class="pointer-events-auto flex items-center gap-0.5 rounded-xl border border-border bg-elevated/95 p-1 shadow-lg backdrop-blur">
        <%= link_to download_image_path(generation),
              class: "grid size-8 place-items-center rounded-lg text-fg-muted transition hover:bg-hover hover:text-fg",
              title: "Download", aria: { label: "Download image" } do %>
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 21h16"/></svg>
        <% end %>
        <%= button_to regenerate_image_path(generation), method: :post,
              class: "grid size-8 place-items-center rounded-lg text-fg-muted transition hover:bg-hover hover:text-fg",
              title: "Regenerate", "aria-label": "Regenerate image" do %>
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"/></svg>
        <% end %>
        <%= button_to image_path(generation), method: :delete,
              class: "grid size-8 place-items-center rounded-lg text-fg-muted transition hover:bg-red-500/15 hover:text-red-600 dark:hover:text-red-400",
              title: "Delete from gallery", "aria-label": "Delete image",
              form: { data: { turbo_confirm: "Remove this image from your gallery?" } } do %>
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M8 6V4h8v2m-9 0 1 14h8l1-14"/></svg>
        <% end %>
      </div>
    </div>

    <div class="px-3 py-2.5">
      <p class="line-clamp-2 text-[12.5px] leading-snug text-fg"><%= generation.prompt %></p>
      <p class="mt-1 truncate text-[11px] text-fg-subtle">
        <%= generation.size %> · <%= generation.quality %> · <%= time_ago_in_words(generation.created_at) %> ago
      </p>
    </div>

  <% elsif generation.failed? %>
    <div class="flex aspect-square w-full flex-col items-center justify-center gap-2 bg-panel px-4 text-center">
      <span class="grid size-10 place-items-center rounded-full bg-red-500/15 text-red-600 dark:text-red-400">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 8v5m0 3h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
      </span>
      <p class="line-clamp-3 text-[12px] leading-snug text-fg-muted"><%= generation.error.presence || "Generation failed." %></p>
      <div class="mt-1 flex items-center gap-2">
        <%= button_to "Regenerate", regenerate_image_path(generation), method: :post,
              class: "rounded-lg border border-border bg-elevated px-2.5 py-1 text-[12px] font-medium text-fg-muted hover:bg-hover hover:text-fg transition" %>
        <%= button_to "Delete", image_path(generation), method: :delete,
              class: "rounded-lg border border-border bg-elevated px-2.5 py-1 text-[12px] font-medium text-fg-muted hover:bg-hover hover:text-red-600 dark:hover:text-red-400 transition" %>
      </div>
    </div>
    <div class="border-t border-border px-3 py-2">
      <p class="truncate text-[12px] text-fg"><%= generation.prompt %></p>
    </div>

  <% else %>
    <%# queued / running — honest skeleton, no fake artwork %>
    <div class="relative aspect-square w-full overflow-hidden bg-elevated">
      <div class="absolute inset-0 animate-pulse bg-gradient-to-br from-panel via-elevated to-panel" aria-hidden="true"></div>
      <span class="absolute inset-0 grid place-items-center">
        <span class="flex items-center gap-2 rounded-full border border-border bg-elevated/90 px-3 py-1.5 text-[12px] font-medium text-fg-muted">
          <svg class="size-3.5 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
          <%= generation.running? ? "Generating…" : "Queued…" %>
        </span>
      </span>
    </div>
    <div class="px-3 py-2.5">
      <p class="line-clamp-2 text-[12.5px] leading-snug text-fg"><%= generation.prompt %></p>
      <p class="mt-1 truncate text-[11px] text-fg-subtle"><%= generation.size %> · <%= generation.quality %></p>
    </div>
  <% end %>
</div>
