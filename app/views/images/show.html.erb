<%# Click-to-enlarge modal. Fills the layout's top-level turbo_frame_tag
    "modal"; closed client-side by images-modal_controller (clears the frame),
    so no extra round-trip and no competing modal systems. %>
<%= turbo_frame_tag "modal" do %>
  <div data-controller="images-modal"
       class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-8"
       role="dialog" aria-modal="true" aria-label="Generated image">
    <div class="absolute inset-0 bg-black/50 dark:bg-black/75" data-action="click->images-modal#close"></div>

    <div class="relative flex max-h-full w-full max-w-3xl flex-col overflow-hidden rounded-2xl border border-border bg-elevated shadow-2xl">
      <div class="flex items-center justify-between gap-3 border-b border-border px-4 py-3">
        <h2 class="min-w-0 truncate text-[14px] font-semibold text-fg"><%= @image_generation.prompt.truncate(90) %></h2>
        <button type="button" data-action="click->images-modal#close"
                class="grid size-9 shrink-0 place-items-center rounded-xl bg-hover text-fg-muted transition hover:text-fg"
                aria-label="Close">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="min-h-0 flex-1 overflow-y-auto p-4">
        <% if @image_generation.succeeded? && @image_generation.asset.present? %>
          <img src="<%= download_image_path(@image_generation) %>"
               alt="<%= @image_generation.prompt.truncate(80) %>"
               class="mx-auto max-h-[60vh] w-auto max-w-full rounded-xl bg-panel object-contain" />
        <% elsif @image_generation.failed? %>
          <p class="rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-[13px] text-red-600 dark:text-red-400">
            <%= @image_generation.error.presence || "Generation failed." %>
          </p>
        <% else %>
          <div class="mx-auto flex max-h-[60vh] aspect-square w-full max-w-md items-center justify-center rounded-xl bg-panel">
            <p class="flex items-center gap-2 text-[13px] text-fg-muted">
              <svg class="size-3.5 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
              Still generating…
            </p>
          </div>
        <% end %>

        <p class="mt-4 text-[13px] leading-relaxed text-fg-muted"><%= @image_generation.prompt %></p>
        <div class="mt-3 flex flex-wrap gap-2">
          <% [{ "Model" => @image_generation.model }, { "Size" => @image_generation.size }, { "Quality" => @image_generation.quality }, { "Status" => @image_generation.status }].each do |pair| %>
            <span class="rounded-lg border border-border bg-panel px-2.5 py-1 text-[11px] text-fg-subtle">
              <span class="font-semibold text-fg-muted"><%= pair.keys.first %>:</span> <%= pair.values.first %>
            </span>
          <% end %>
        </div>
      </div>

      <div class="flex items-center justify-end gap-2 border-t border-border px-4 py-3">
        <% if @image_generation.succeeded? && @image_generation.asset.present? %>
          <%= link_to "Download", download_image_path(@image_generation),
                class: "rounded-xl border border-border bg-panel px-3.5 py-2 text-[13px] font-medium text-fg-muted transition hover:bg-hover hover:text-fg" %>
        <% end %>
        <%= button_to "Regenerate", regenerate_image_path(@image_generation), method: :post,
              class: "rounded-xl bg-accent px-3.5 py-2 text-[13px] font-semibold text-accent-fg transition hover:brightness-110" %>
      </div>
    </div>
  </div>
<% end %>
