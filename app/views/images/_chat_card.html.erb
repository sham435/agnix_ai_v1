<%# Chat-surface card for a chat-originated generation, appended to
    #messages-list by Images::GenerateJob's broadcast. Success shows the image
    (never any provider reasoning); failure says so honestly and links to the
    gallery where Regenerate lives. Rendered from a job too, so it must not
    depend on current_user or request state. %>
<div class="mx-auto w-full max-w-3xl px-4 py-2 sm:px-6">
  <div class="rounded-2xl border border-border bg-elevated p-3">
    <% if generation.succeeded? && generation.asset.present? %>
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-fg-subtle">Generated image</p>
      <img src="<%= download_image_path(generation) %>"
           alt="<%= generation.prompt.truncate(80) %>"
           class="max-h-[420px] w-auto max-w-full rounded-xl bg-panel object-contain" />
      <% if generation.metadata["revised_prompt"].present? %>
        <p class="mt-2 text-[12px] leading-snug text-fg-muted">Provider refined the prompt: “<%= generation.metadata["revised_prompt"] %>”</p>
      <% end %>
      <p class="mt-2 truncate text-[11px] text-fg-subtle">
        <%= generation.size %> · <%= generation.quality %> ·
        <%= link_to "Open in gallery", images_path, class: "text-accent-text hover:underline" %>
      </p>
    <% elsif generation.failed? %>
      <p class="text-[13px] leading-snug text-red-600 dark:text-red-400">
        Image generation failed: <%= generation.error.presence || "unknown provider error." %>
        <%= link_to "Try again from the gallery.", images_path, class: "text-accent-text hover:underline" %>
      </p>
    <% else %>
      <p class="flex items-center gap-2 text-[13px] text-fg-muted">
        <svg class="size-3.5 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
        Generating your image…
      </p>
    <% end %>
  </div>
</div>
