<!-- Header -->
<header class="sticky top-0 z-20 flex h-[64px] items-center justify-between gap-3 overflow-hidden border-b border-border bg-sidebar/80 glass px-4">
  <div class="flex items-center gap-2 min-w-0">
    <button id="menuBtn" class="lg:hidden grid size-9 place-items-center rounded-xl bg-hover hover:bg-border text-fg-muted shrink-0">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <div class="flex items-center gap-3 min-w-0">
      <span class="size-9 rounded-xl bg-gradient-to-br from-emerald-500/25 to-emerald-700/15 border border-accent/25 grid place-items-center text-accent-text shrink-0">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4"/></svg>
      </span>
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <span class="text-[14px] font-semibold text-fg truncate"><%= @conversation.agent.name %></span>
          <span class="inline-flex items-center gap-1 text-[10px] font-medium text-accent-text bg-accent/10 border border-accent/20 rounded-full px-2 py-0.5">
            <span class="size-1.5 rounded-full bg-accent"></span>
            Online
          </span>
        </div>
        <div class="flex items-center gap-1.5 text-[11px] text-fg-subtle">
          <%= form_with model: @conversation.agent, url: agent_path(@conversation.agent), method: :patch, class: "inline-flex items-center", data: { turbo: true } do |f| %>
            <%= hidden_field_tag :return_to, conversation_path(@conversation) %>
            <span class="text-fg-subtle">Model</span>
            <%= f.select :model, @conversation.agent.model_select_options, { selected: @conversation.agent.model }, class: "text-[11px] font-mono text-accent-text bg-transparent border-0 outline-none cursor-pointer appearance-none pr-3 hover:underline transition", data: { controller: "auto-submit", action: "change->auto-submit#submit" } %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <div class="flex items-center gap-2 sm:gap-3 min-w-0">
    <%= link_to regenerate_conversation_path(@conversation), method: :post,
        class: "inline-flex items-center gap-2 rounded-full bg-panel hover:bg-hover border border-border px-2.5 sm:px-4 py-2 text-sm text-fg-muted hover:text-fg transition shrink-0",
        data: { turbo_method: :post, turbo_confirm: "Regenerate last response?" } do %>
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 12a8 8 0 0 1 8-8v0a8 8 0 0 1 8 8" stroke-width="2" stroke-linecap="round"/></svg>
      <span class="hidden sm:inline">Regenerate</span>
    <% end %>

    <%= render "mode_toggle" %>

    <div class="size-9 shrink-0 rounded-full bg-gradient-to-br from-amber-500 to-emerald-500 grid place-items-center text-sm font-bold text-black ring-2 ring-border">
      <%= current_user.name.to_s.first.upcase %>
    </div>
  </div>
</header>

<!-- Messages -->
<main class="flex-1 overflow-y-auto overflow-x-hidden" id="messages-container" data-controller="chat" data-conversation-id="<%= @conversation.id %>">
  <div class="mx-auto w-full max-w-[820px] px-4 sm:px-5 lg:px-6 py-6 sm:py-8 space-y-6 sm:space-y-8" id="messages-list">
    <% @messages.each do |message| %>
      <%= render "messages/message", message: message %>
    <% end %>

    <!-- Agent OS plan placeholder (replaced via Turbo Stream) -->
    <div id="agent-plan-placeholder"></div>
  </div>

  <!-- Scroll to bottom spacer (safe-area aware) -->
  <div class="h-24 sm:h-32" aria-hidden="true"></div>
</main>

<!-- Input -->
<div id="message-form"
     class="sticky bottom-0 z-10 border-t border-border-subtle bg-gradient-to-b from-transparent to-canvas/95 backdrop-blur-sm px-3 sm:px-4 pt-3 sm:pt-4"
     style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
  <div class="mx-auto w-full max-w-[820px]">
    <%= render "messages/form", conversation: @conversation, message: Message.new %>
  </div>
</div>

<!-- Action Cable subscription for streaming -->
<%= turbo_stream_from @conversation %>

<%= render "shared/sidebar_js" %>
