<!-- Header -->
<header class="sticky top-0 z-20 flex h-[64px] items-center justify-between gap-3 border-b border-border bg-sidebar/80 glass px-4">
  <div class="flex items-center gap-2 min-w-0">
    <button id="menuBtn" class="lg:hidden grid size-9 place-items-center rounded-xl bg-hover hover:bg-border text-fg-muted shrink-0">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <div class="flex items-center gap-3 min-w-0">
      <span class="size-9 rounded-xl bg-gradient-to-br from-emerald-500/25 to-emerald-700/15 border border-accent/25 grid place-items-center text-accent-text shrink-0">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4"/></svg>
      </span>
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <span class="text-[14px] font-semibold text-fg truncate"><%= @conversation.agent.name %></span>
          <span class="inline-flex items-center gap-1 text-[10px] font-medium text-accent-text bg-accent/10 border border-accent/20 rounded-full px-2 py-0.5">
            <span class="size-1.5 rounded-full bg-accent"></span>
            Online
          </span>
        </div>
        <div class="flex items-center gap-1.5 text-[11px] text-fg-subtle">
          <div class="relative" data-controller="model-selector" data-model-selector-conversation-id-value="<%= @conversation.id %>">
            <button type="button" class="text-accent-text hover:underline py-2" data-action="model-selector#toggle" aria-label="Select chat model">
              Model · <span data-model-selector-target="label"><%= @conversation.agent.model %></span>
            </button>
            <div hidden data-model-selector-target="panel" class="absolute left-0 top-full z-50 w-80 max-w-[85vw] rounded-xl border border-border bg-surface-raised p-3 shadow-xl">
              <input type="search" placeholder="Search models" aria-label="Search models" class="input-field w-full" data-model-selector-target="search" data-action="input->model-selector#search">
              <div class="max-h-72 overflow-y-auto" data-model-selector-target="list"></div>
              <p role="status" class="text-xs text-fg-subtle my-2" data-model-selector-target="status"></p>
              <div class="flex justify-between gap-2">
                <button type="button" class="text-xs text-accent-text py-2" data-action="model-selector#refresh">Refresh catalogue</button>
                <button type="button" class="text-xs text-accent-text py-2" data-action="model-selector#reset">Use organization default</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="flex items-center gap-2 sm:gap-3 min-w-0">
    <%= link_to regenerate_conversation_path(@conversation), method: :post,
        class: "inline-flex items-center gap-2 rounded-full bg-panel hover:bg-hover border border-border px-2.5 sm:px-4 py-2 text-sm text-fg-muted hover:text-fg transition shrink-0",
        data: { turbo_method: :post, turbo_confirm: "Regenerate last response?" } do %>
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 12a8 8 0 0 1 8-8v0a8 8 0 0 1 8 8" stroke-width="2" stroke-linecap="round"/></svg>
      <span class="hidden sm:inline">Regenerate</span>
    <% end %>

    <%= render "mode_toggle" %>

    <%# Opens the Coding Workspace slide-over for this conversation's sandbox.
        Nothing is fetched until it is clicked — the frame has no src. %>
    <button type="button"
            class="inline-flex items-center gap-2 rounded-full bg-panel hover:bg-hover border border-border px-2.5 py-2 text-sm text-fg-muted hover:text-fg transition shrink-0"
            data-action="click->workspace-panel#open"
            data-workspace-panel-url-param="<%= workspace_panel_path(conversation_id: @conversation.id) %>"
            aria-label="Open coding workspace">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 8-4 4 4 4M16 8l4 4-4 4M13 5l-2 14"/></svg>
      <span class="hidden sm:inline">Workspace</span>
    </button>

    <div class="shrink-0"><%= render "shared/user_menu" %></div>
  </div>
</header>

<!-- Messages -->
<main class="flex-1 overflow-y-auto overflow-x-hidden" id="messages-container" data-controller="chat" data-conversation-id="<%= @conversation.id %>"
      data-background-active="<%= @background_tasks[:active] %>"
      data-background-queued="<%= @background_tasks[:queued] %>"
      data-background-request-id="<%= @background_tasks[:active_request_id] %>">
  <div class="mx-auto w-full max-w-[820px] px-4 sm:px-5 lg:px-6 py-6 sm:py-8 space-y-6 sm:space-y-8" id="messages-list">
    <% @messages.each do |message| %>
      <%= render "messages/message", message: message %>
    <% end %>

    <!-- Agent OS plan placeholder (replaced via Turbo Stream) -->
    <div id="agent-plan-placeholder"></div>
  </div>

  <!-- Scroll to bottom spacer (safe-area aware) -->
  <div class="h-24 sm:h-32" aria-hidden="true"></div>
</main>

<!-- Input -->
<div id="message-form"
     class="sticky bottom-0 z-10 border-t border-border-subtle bg-gradient-to-b from-transparent to-canvas/95 backdrop-blur-sm px-3 sm:px-4 pt-3 sm:pt-4"
     style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
  <div class="mx-auto w-full max-w-[820px]">
    <%= render "messages/form", conversation: @conversation, message: Message.new %>
  </div>
</div>

<!-- Action Cable subscription for streaming -->
<%= turbo_stream_from @conversation %>

<%= render "shared/sidebar_js" %>
