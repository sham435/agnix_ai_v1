<div class="relative" data-controller="model-selector" <% if conversation %>data-model-selector-conversation-id-value="<%= conversation.id %>"<% end %>>
  <button type="button" class="text-accent-text hover:underline py-2" data-action="model-selector#toggle" aria-label="Select chat model" data-model-selector-target="button">
    Model · <span data-model-selector-target="label">Loading…</span>
  </button>
  <div hidden data-model-selector-target="backdrop" class="fixed inset-0 z-40 bg-black/30" data-action="click->model-selector#close"></div>
  <div hidden data-model-selector-target="panel" class="fixed right-0 top-0 z-50 h-full w-80 max-w-[90vw] overflow-y-auto border-l border-border bg-surface-raised p-4 shadow-2xl">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-[15px] font-semibold text-fg">Select model</h2>
      <button type="button" class="grid size-8 place-items-center rounded-lg hover:bg-hover text-fg-subtle" data-action="model-selector#close" aria-label="Close">✕</button>
    </div>
    <input type="search" placeholder="Search models" aria-label="Search models" class="input-field w-full mb-3" data-model-selector-target="search" data-action="input->model-selector#search">
    <div class="max-h-60 overflow-y-auto" data-model-selector-target="list"></div>
    <p role="status" class="text-xs text-fg-subtle my-2" data-model-selector-target="status"></p>
    <div class="flex justify-between gap-2">
      <button type="button" class="text-xs text-accent-text py-2" data-action="model-selector#refresh">Refresh catalogue</button>
      <% if conversation %>
        <button type="button" class="text-xs text-accent-text py-2" data-action="model-selector#reset">Use organization default</button>
      <% end %>
      <%= link_to "Manage providers", settings_integrations_path, class: "text-xs text-accent-text py-2" %>
    </div>
  </div>
</div>
