<div class="relative w-full max-w-[520px]" data-controller="model-selector" <% if conversation %>data-model-selector-conversation-id-value="<%= conversation.id %>"<% end %>>
  <button type="button" class="text-accent-text hover:underline py-2" data-action="model-selector#toggle" aria-label="Select chat model" data-model-selector-target="button">
    Model · <span data-model-selector-target="label">Loading…</span>
  </button>
  <div hidden data-model-selector-target="panel" class="mt-2 w-full rounded-xl border border-border bg-surface-raised p-3 shadow-lg">
    <div class="mb-2 flex items-center justify-between">
      <h2 class="text-[14px] font-semibold text-fg">Select model</h2>
      <button type="button" class="grid size-7 place-items-center rounded-lg hover:bg-hover text-fg-subtle" data-action="model-selector#close" aria-label="Close model picker">✕</button>
    </div>
    <input type="search" placeholder="Search models" aria-label="Search models" class="input-field w-full mb-2" data-model-selector-target="search" data-action="input->model-selector#search">
    <div class="max-h-[50vh] overflow-y-auto" data-model-selector-target="list"></div>
    <p role="status" class="text-xs text-fg-subtle my-2" data-model-selector-target="status"></p>
    <div class="flex flex-wrap justify-between gap-2">
      <button type="button" class="text-xs text-accent-text py-1" data-action="model-selector#refresh">Refresh catalogue</button>
      <% if conversation %>
        <button type="button" class="text-xs text-accent-text py-1" data-action="model-selector#reset">Use organization default</button>
      <% end %>
      <%= link_to "Manage providers", settings_integrations_path, class: "text-xs text-accent-text py-1" %>
    </div>
  </div>
</div>
