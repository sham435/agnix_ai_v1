<%#
  Devices this account is signed in on. A row is one sign-in; revoking it stops
  that browser on its next request, whatever cookies it still holds. Signing
  out everywhere also invalidates sessions that predate these rows, which is why
  it takes this device too.
-%>
<%= link_to "← Security & privacy", account_panel_path(section: "security"),
      class: "inline-flex items-center gap-1 text-[12px] text-fg-subtle hover:text-fg" %>

<div class="space-y-3">
  <% if @devices.empty? %>
    <div class="card">
      <p class="text-[12px] leading-relaxed text-fg-subtle">
        No device records yet — sign-ins only started being listed with this
        panel, so your current session will appear after the next sign-in.
      </p>
    </div>
  <% end %>

  <% @devices.each do |device| %>
    <% current = Current.auth_session&.id == device.id %>
    <div class="card flex items-start justify-between gap-3 py-3">
      <div class="min-w-0">
        <p class="flex items-center gap-2 text-[13px] font-medium text-fg">
          <%= device.device %>
          <% if current %>
            <span class="badge bg-accent/15 text-accent-text">This device</span>
          <% end %>
        </p>
        <p class="mt-1 text-[12px] text-fg-subtle">
          Seen <%= time_ago_in_words(device.last_seen_at) %> ago · from <%= device.ip %> ·
          signed in <%= l(device.created_at.to_date, format: :long) %>
        </p>
      </div>

      <% unless current %>
        <%= button_to "Revoke", account_device_path(device), method: :delete,
              class: "btn-secondary shrink-0 px-3 py-1.5 text-[12px] text-red-600 dark:text-red-400" %>
      <% end %>
    </div>
  <% end %>

  <div class="card space-y-3">
    <h3 class="text-[14px] font-medium text-fg">Sign out everywhere</h3>
    <p class="text-[12px] leading-relaxed text-fg-subtle">
      Revokes every device and refuses any session issued before now, including
      ones that predate this list. You land back on the sign-in page.
    </p>
    <%= button_to "Sign out everywhere", account_devices_path, method: :delete,
          form: { data: { turbo_frame: "_top" } },
          class: "btn-secondary w-full text-[13px] text-red-600 dark:text-red-400" %>
  </div>
</div>
