<%#
  Usage & membership. The numbers come from Quota.summary_for, which reads the
  daily ceiling and today's ledger in one pass, so the bar, the counter and the
  remaining figure all describe the same moment.
-%>
<div class="card space-y-4">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <h3 class="truncate text-[14px] font-semibold text-fg"><%= @organization&.name || "No organization" %></h3>
      <p class="text-[12px] text-fg-subtle mt-0.5">
        Plan: <%= (@organization&.plan.presence || "free").capitalize %>
      </p>
    </div>
    <span class="shrink-0 rounded-full px-2.5 py-1 text-[11px] font-semibold <%= @quota_summary.metered? ? "bg-emerald-500/15 text-emerald-500" : "bg-hover text-fg-muted" %>">
      <%= @quota_summary.metered? ? "Metered" : "Unmetered" %>
    </span>
  </div>

  <% if @quota_summary.metered? %>
    <% pct = @quota_summary.cap.positive? ? [ ( @quota_summary.used * 100.0 / @quota_summary.cap ).round, 100 ].min : 100 %>
    <div class="space-y-2">
      <div class="flex items-baseline justify-between text-[12px]">
        <span class="text-fg-subtle">Tokens used today</span>
        <span class="font-semibold tabular-nums text-fg">
          <%= number_with_delimiter(@quota_summary.used) %> / <%= number_with_delimiter(@quota_summary.cap) %>
        </span>
      </div>
      <div class="h-2 overflow-hidden rounded-full bg-hover"
           role="progressbar" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100"
           aria-label="Share of today's token allowance already used">
        <div class="h-full rounded-full <%= pct >= 90 ? "bg-red-500" : "bg-accent" %>" style="width:<%= pct %>%"></div>
      </div>
      <p class="text-[12px] text-fg-muted">
        <% if @quota_summary.remaining.to_i.positive? %>
          <%= number_with_delimiter(@quota_summary.remaining) %> left until the allowance resets at midnight.
        <% else %>
          The allowance is spent for today. New turns are refused until it resets at midnight.
        <% end %>
      </p>
    </div>
  <% else %>
    <p class="text-[12px] leading-relaxed text-fg-muted">
      This organization has no daily token ceiling. Each turn is still written to the
      usage ledger, so these figures stay correct if a cap is ever applied.
    </p>
  <% end %>

  <% if @organization %>
    <%= link_to settings_billing_path,
          data: { turbo_frame: "_top" },
          class: "btn-secondary w-full text-[13px]" do %>
      Billing, invoices and Stripe
    <% end %>
  <% end %>
</div>

<%#
  Membership. The state shown is the organization's real `plan` column — the
  same one Quota reads — so this card can never claim a Coffee Key was redeemed
  when nothing redeemed one. Redemption itself is not wired up on this build
  (no keys exist yet), so there is deliberately no redeem control here.
-%>
<div class="card space-y-3">
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-[14px] font-semibold text-fg">Membership</h3>
    <span class="shrink-0 rounded-full bg-hover px-2.5 py-1 text-[11px] font-semibold text-fg-muted">
      <%= @quota_summary.metered? ? "Active allowance" : "No daily cap" %>
    </span>
  </div>
  <p class="text-[12px] leading-relaxed text-fg-muted">
    <% if @quota_summary.metered? %>
      This organization is on the <%= @quota_summary.plan.capitalize %> plan:
      <%= number_with_delimiter(@quota_summary.cap) %> tokens a day, resetting at midnight.
    <% else %>
      This organization carries no daily token cap, so there is nothing to top up.
      A paid allowance would show its remaining tokens in the card above.
    <% end %>
  </p>
</div>

