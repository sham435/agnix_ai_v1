<div class="relative" data-controller="dropdown" data-user-menu>
  <button type="button"
          data-dropdown-target="button"
          class="size-8 rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600 grid place-items-center text-xs font-bold text-black focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
          data-action="click->dropdown#toggle"
          aria-haspopup="true"
          aria-expanded="false"
          title="Open user menu (g a)">
    <%= current_user.name.first.upcase %>
  </button>

  <div data-dropdown-target="menu"
       class="hidden absolute right-0 mt-2 w-56 rounded-xl border border-border bg-elevated shadow-xl py-1 z-50">
    <div class="px-3 py-2 border-b border-border">
      <div class="text-[13px] font-medium text-fg"><%= current_user.name %></div>
      <div class="text-[12px] text-fg-muted truncate"><%= current_user.email %></div>
    </div>

    <%# Each item is a real link to /account?section=… that the panel controller
        turns into a slide-over; with JavaScript off it opens the same section as
        a page. The two menus on a chat page share one panel instance.

        `data-turbo="false"` is what makes that split work: Turbo watches clicks
        from the document element, before Stimulus's document-level handler can
        prevent the default, so without it every item would navigate the page
        out from under the conversation instead of opening the panel. %>
    <%= link_to "Account settings", account_panel_path(section: "account"),
          class: "block px-3 py-2 text-[13px] text-fg-muted hover:bg-hover hover:text-fg",
          data: { turbo: "false", action: "click->dropdown#close click->account-panel#open",
                  account_panel_url_param: account_panel_path(section: "account") } %>

    <%= link_to account_panel_path(section: "security"),
          class: "flex items-center justify-between gap-2 px-3 py-2 text-[13px] text-fg-muted hover:bg-hover hover:text-fg",
          data: { turbo: "false", action: "click->dropdown#close click->account-panel#open",
                  account_panel_url_param: account_panel_path(section: "security") } do %>
      <span>Security &amp; two-factor</span>
      <span class="text-[11px] <%= current_user.second_factor_enabled? ? "text-emerald-500" : "text-fg-subtle" %>">
        <%= current_user.second_factor_enabled? ? "On" : "Off" %>
      </span>
    <% end %>

    <%= link_to "Usage & membership", account_panel_path(section: "usage"),
          class: "block px-3 py-2 text-[13px] text-fg-muted hover:bg-hover hover:text-fg",
          data: { turbo: "false", action: "click->dropdown#close click->account-panel#open",
                  account_panel_url_param: account_panel_path(section: "usage") } %>

    <div class="border-t border-border my-1"></div>

    <button type="button"
            class="w-full text-left px-3 py-2 text-[13px] text-red-600 dark:text-red-400 hover:bg-hover"
            data-action="click->dropdown#openLogoutModal">
      Log out
    </button>

    <div class="px-3 py-2 border-t border-border text-[11px] text-fg-subtle leading-relaxed">
      <div>Press <kbd class="px-1 py-0.5 rounded bg-panel border border-border">g</kbd> then <kbd class="px-1 py-0.5 rounded bg-panel border border-border">a</kbd> to open</div>
      <div>Press <kbd class="px-1 py-0.5 rounded bg-panel border border-border">Shift</kbd>+<kbd class="px-1 py-0.5 rounded bg-panel border border-border">L</kbd> to log out</div>
    </div>
  </div>
</div>
