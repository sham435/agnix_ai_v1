<%#
  Phase 1c — ⌘K command palette. Mounted once in the layout. Opens on the
  "shams:search" window event (dispatched by shortcuts_controller); the modal is
  hidden via the HTML `hidden` attribute (not a Tailwind class) so Stimulus can
  reveal it reliably. Results come from GET /conversations/search, which is
  scoped to the signed-in user server-side.
-%>
<div data-controller="search-palette"
     data-search-palette-search-url-value="<%= search_conversations_path(format: :json) %>">
  <div data-search-palette-target="modal"
       data-action="click->search-palette#backdrop"
       class="fixed inset-0 z-[70] grid place-items-start justify-center bg-black/50 backdrop-blur-sm px-4 pt-[12vh]"
       role="dialog"
       aria-modal="true"
       aria-label="Search conversations"
       hidden>
    <div class="w-full max-w-[560px] overflow-hidden rounded-2xl border border-border bg-panel shadow-2xl">
      <div class="flex items-center gap-3 border-b border-border px-4">
        <svg class="size-5 shrink-0 text-fg-subtle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search"
               data-search-palette-target="input"
               data-action="input->search-palette#query keydown->search-palette#onKeydown"
               autocomplete="off"
               placeholder="Search conversations…"
               aria-label="Search conversations"
               class="w-full bg-transparent py-4 text-[15px] text-fg placeholder-fg-subtle outline-none">
        <kbd class="shrink-0 rounded-md border border-border px-1.5 py-0.5 text-[11px] text-fg-subtle">esc</kbd>
      </div>
      <div class="max-h-[50vh] overflow-y-auto p-2">
        <div data-search-palette-target="results" class="space-y-0.5"></div>
        <p data-search-palette-target="empty" class="px-3 py-6 text-center text-[13px] text-fg-subtle">Type to search your conversations.</p>
      </div>
      <div class="flex items-center justify-between border-t border-border px-4 py-2 text-[11px] text-fg-subtle">
        <span>Press <kbd class="rounded bg-hover px-1">↵</kbd> to open the top result</span>
        <span>Shams <span class="font-arabic text-accent">شمس</span></span>
      </div>
    </div>
  </div>
</div>
