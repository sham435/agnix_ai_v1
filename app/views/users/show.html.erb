<%= render "layouts/chat_layout" do %>
  <header class="sticky top-0 z-20 flex h-[64px] items-center justify-between gap-3 border-b border-border-subtle bg-sidebar/80 glass px-4">
    <div class="flex items-center gap-3">
      <div class="size-10 rounded-xl bg-accent/10 grid place-items-center text-accent-text">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>
      </div>
      <div>
        <h1 class="text-[16px] font-semibold text-fg"><%= @user.name %></h1>
        <p class="text-[12px] text-fg-subtle"><%= @user.email %></p>
      </div>
    </div>
    <% if @user == current_user %>
      <%= link_to settings_profile_path, class: "btn-secondary text-[13px]" do %>
        Settings
      <% end %>
    <% end %>
  </header>

  <main class="flex-1 overflow-y-auto p-6">
    <div class="mx-auto max-w-[700px] space-y-6">
      <div class="card">
        <h2 class="text-[15px] font-medium text-fg mb-4">Profile</h2>
        <%= form_with model: @user, url: user_path(@user), method: :patch, class: "space-y-4" do |f| %>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[13px] font-medium text-fg-muted mb-1">Name</label>
              <%= f.text_field :name, class: "input-field" %>
            </div>
            <div>
              <label class="block text-[13px] font-medium text-fg-muted mb-1">Email</label>
              <%= f.email_field :email, class: "input-field" %>
            </div>
          </div>
          <%= f.submit "Update Profile", class: "btn-primary ml-auto" if @user == current_user %>
        <% end %>
      </div>

      <% if @conversations&.any? %>
        <div class="card">
          <h2 class="text-[15px] font-medium text-fg mb-3">Recent Conversations</h2>
          <div class="space-y-2">
            <% @conversations.each do |conv| %>
              <%= link_to conversation_path(conv), class: "flex items-center justify-between rounded-lg bg-panel px-3 py-2 text-[13px] hover:bg-hover transition" do %>
                <span class="text-fg-muted truncate"><%= conv.title || "Untitled" %></span>
                <span class="text-fg-subtle shrink-0 ml-3"><%= time_ago(conv.updated_at) %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @memories&.any? %>
        <div class="card">
          <h2 class="text-[15px] font-medium text-fg mb-3">Recent Memories</h2>
          <div class="space-y-2">
            <% @memories.each do |memory| %>
              <div class="rounded-lg bg-hover px-3 py-2 text-[13px] text-fg-muted"><%= truncate(strip_tags(memory.content), length: 160) %></div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </main>

  <%= render "shared/sidebar_js" %>
<% end %>