<%# Phase 5c — /explore: curated agent templates in the app shell. GET is
    read-only (cards render from the frozen catalog; nothing is persisted
    until "Start chat" POSTs /explore/start). Category chips + text search
    are plain JS-free GET filters. The sidebar "Explore" slot lights up on
    its own because AppShell::Features detects the mounted /explore route. %>
<header class="sticky top-0 z-20 flex h-[64px] items-center justify-between gap-3 border-b border-border bg-sidebar/80 glass px-4">
  <div class="flex items-center gap-2 min-w-0">
    <button id="menuBtn" class="lg:hidden grid size-9 place-items-center rounded-xl bg-hover text-fg-muted transition hover:bg-border hover:text-fg" aria-label="Open navigation menu">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <h1 class="text-[16px] font-semibold text-fg truncate">Explore <span class="font-arabic text-orange-400/90">شمس</span> capabilities</h1>
    <span class="hidden text-[12px] text-fg-subtle sm:inline">· <%= @templates.size %> template<%= "s" unless @templates.size == 1 %></span>
  </div>
</header>

<main class="flex-1 overflow-y-auto">
  <div class="mx-auto max-w-[1100px] px-4 py-6 sm:px-6">
    <p class="mb-5 text-[13px] leading-5 text-fg-muted">
      Ready-made specialists for common work. Starting a chat adds the template to
      <strong class="font-semibold text-fg"><%= current_organization.name %></strong> as a real agent — once per template,
      then it's yours to keep, customize, and reuse like any other agent.
    </p>

    <%# JS-free filter: category chips keep the current text query; the search
        box keeps the current category. %>
    <div class="mb-5 flex flex-wrap items-center gap-2">
      <%= link_to "All", explore_path(q: params[:q].presence),
            class: "rounded-full px-3 py-1.5 text-[12px] font-medium transition " +
                   (params[:category].blank? ? "bg-accent text-accent-fg" : "bg-hover text-fg-muted hover:text-fg") %>
      <% @categories.each do |category| %>
        <%= link_to category, explore_path(category: category, q: params[:q].presence),
              class: "rounded-full px-3 py-1.5 text-[12px] font-medium transition " + (params[:category] == category ? "bg-accent text-accent-fg" : "bg-hover text-fg-muted hover:text-fg") %>
      <% end %>
      <%= form_with url: explore_path, method: :get, class: "ml-auto flex items-center gap-2" do %>
        <% if params[:category].present? %>
          <%= hidden_field_tag :category, params[:category] %>
        <% end %>
        <%= search_field_tag :q, params[:q],
              placeholder: "Search templates…",
              class: "input-field !w-48 text-[13px]",
              "aria-label": "Search agent templates" %>
      <% end %>
    </div>

    <% if @templates.any? %>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
        <% @templates.each do |template| %>
          <%= render Agents::CardComponent.new(
                agent: Agents::Templates.to_agent(template, organization: current_organization),
                start_path: explore_start_path(slug: template[:slug]),
                customize_path: new_agent_path(template: template[:slug]),
                icon: template[:icon],
                installed: @installed_slugs.include?(template[:slug])
              ) %>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-2xl border border-dashed border-border bg-panel/60 px-6 py-10 text-center">
        <p class="text-[14px] font-medium text-fg">No template matches that search</p>
        <p class="mt-1 text-[12.5px] text-fg-muted">Try a different word, or <%= link_to "clear the filters", explore_path, class: "text-accent underline underline-offset-2" %>.</p>
      </div>
    <% end %>
  </div>
</main>
