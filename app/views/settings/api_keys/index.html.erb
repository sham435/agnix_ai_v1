<%= render "layouts/chat_layout" do %>
  <header class="sticky top-0 z-20 flex h-[64px] items-center justify-between gap-3 border-b border-border-subtle bg-sidebar/80 glass px-4">
    <div class="flex items-center gap-2">
      <button id="menuBtn" class="lg:hidden grid size-9 place-items-center rounded-xl bg-panel hover:bg-hover text-fg-muted">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <h1 class="text-[16px] font-semibold text-fg">API Keys</h1>
    </div>
    <%= link_to settings_integrations_path, class: "btn-secondary text-[13px]" do %>
      Manage providers
    <% end %>
  </header>

  <main class="flex-1 overflow-y-auto p-6">
    <div class="mx-auto max-w-[700px] space-y-6">
      <div class="card">
        <h2 class="text-[15px] font-medium text-fg mb-4">Keys & Access</h2>
        <div class="rounded-2xl bg-gradient-to-br from-emerald-500/10 to-transparent border border-emerald-500/20 p-5">
          <div class="flex items-start gap-4">
            <div class="size-10 rounded-xl bg-accent/10 grid place-items-center text-accent-text shrink-0">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="7.5" cy="15.5" r="4.5"/><path d="m11 12 8.5-8.5M17 6l3 3M14 9l2 2"/></svg>
            </div>
            <div>
              <h3 class="text-[14px] font-medium text-fg">Provider API keys</h3>
              <p class="text-[13px] text-fg-muted mt-1 leading-relaxed">Model provider credentials are managed per integration. Configure your Anthropic, OpenAI, or OpenRouter keys under Integrations.</p>
              <%= link_to settings_integrations_path, class: "mt-3 inline-flex items-center gap-2 text-[13px] font-medium text-accent-text underline-offset-2 hover:underline transition" do %>
                Configure integrations
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <h2 class="text-[15px] font-medium text-fg mb-3">Backend API</h2>
        <p class="text-[13px] text-fg-muted mb-3">Programmatic access to conversations, agents, and runs is available under <code class="text-accent-text font-mono text-[12px]">/api/v1</code> while signed in.</p>
        <pre class="rounded-lg bg-hover border border-border-subtle p-4 text-[12px] text-fg-muted font-mono overflow-x-auto">curl -b cookies.txt https://shams.example/api/v1/conversations</pre>
      </div>
    </div>
  </main>

  <%= render "shared/sidebar_js" %>
<% end %>