<%= render "layouts/chat_layout" do %>
  <header class="sticky top-0 z-20 flex h-[64px] items-center justify-between gap-3 border-b border-border-subtle bg-sidebar/80 glass px-4">
    <div class="flex items-center gap-2">
      <button id="menuBtn" class="lg:hidden grid size-9 place-items-center rounded-xl bg-panel hover:bg-hover text-fg-muted">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <h1 class="text-[16px] font-semibold text-fg">Set Up Two-Factor</h1>
    </div>
  </header>

  <main class="flex-1 overflow-y-auto p-6">
    <div class="mx-auto max-w-[600px] space-y-6">
      <div class="card space-y-5">
        <div>
          <h2 class="text-[15px] font-medium text-fg">1. Scan this code</h2>
          <p class="text-[13px] text-fg-subtle mt-1">
            Add it in Google Authenticator, Authy, 1Password or any other TOTP app. It is shown only on this page.
          </p>
        </div>

        <div class="flex justify-center rounded-xl bg-white p-4">
          <%= @two_factor.qr_svg %>
        </div>

        <div>
          <p class="text-[12px] font-medium text-fg-muted mb-1">Can't scan? Enter this key instead:</p>
          <code class="block break-all rounded-lg bg-panel border border-border px-3 py-2 font-mono text-[13px] text-fg">
            <%= @two_factor.secret.scan(/.{1,4}/).join(" ") %>
          </code>
          <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-[12px] text-fg-subtle">
            <dt class="font-medium">Account</dt><dd class="truncate"><%= current_user.email %></dd>
            <dt class="font-medium">Issuer</dt><dd><%= TwoFactor::ISSUER %></dd>
            <dt class="font-medium">Type</dt><dd>Time-based</dd>
          </dl>
        </div>
      </div>

      <div class="card space-y-4">
        <div>
          <h2 class="text-[15px] font-medium text-fg">2. Enter the 6-digit code</h2>
          <p class="text-[13px] text-fg-subtle mt-1">Your password is not saved again, and nothing changes until this code checks out.</p>
        </div>

        <%= form_with url: confirm_settings_two_factor_path, method: :post, class: "flex items-center gap-3" do %>
          <input type="text"
                 name="code"
                 inputmode="numeric"
                 autocomplete="one-time-code"
                 pattern="[0-9]{6}"
                 maxlength="6"
                 placeholder="123456"
                 class="input-field w-40 text-center tracking-[0.3em] font-mono"
                 aria-label="Six digit code"
                 required>
          <button type="submit" class="btn-primary">Activate</button>
          <%= link_to "Cancel", settings_two_factor_path, class: "btn-secondary" %>
        <% end %>
      </div>
    </div>
  </main>

  <%= render "shared/sidebar_js" %>
<% end %>
