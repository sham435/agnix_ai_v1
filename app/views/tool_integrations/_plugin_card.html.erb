<%# Phase 4b marketplace card — one catalog plugin, its org connection state,
    and the actions that keep the legacy CRUD working (manage/edit/delete).
    DOM id is stable per provider so the toggle Turbo Stream can re-replace
    this exact card in place. %>
<div id="plugin-card-<%= plugin[:key] %>"
     class="flex flex-col gap-3 rounded-2xl border border-border bg-panel p-4 transition hover:border-emerald-500/30">
  <div class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 items-center gap-3">
      <div class="grid size-10 shrink-0 place-items-center rounded-xl bg-gradient-to-b from-emerald-400/15 to-emerald-600/15 text-[13px] font-bold text-emerald-600 dark:text-emerald-400">
        <%= plugin[:name].first(1) %>
      </div>
      <div class="min-w-0">
        <h3 class="truncate text-[14px] font-semibold text-fg"><%= plugin[:name] %></h3>
        <span class="inline-block mt-0.5 rounded-full border border-border px-2 py-0.5 text-[10.5px] font-medium uppercase tracking-wide text-fg-subtle">
          <%= plugin[:category] %>
        </span>
      </div>
    </div>
    <% if integration %>
      <span class="shrink-0 rounded-full px-2.5 py-1 text-[11px] font-semibold <%= integration.is_active? ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-hover text-fg-subtle" %>">
        <%= integration.is_active? ? "Connected" : "Paused" %>
      </span>
    <% else %>
      <span class="shrink-0 rounded-full bg-hover px-2.5 py-1 text-[11px] font-semibold text-fg-subtle">Not connected</span>
    <% end %>
  </div>

  <p class="text-[12.5px] leading-5 text-fg-muted"><%= plugin[:description] %></p>

  <div class="flex items-center gap-3 text-[11px] text-fg-subtle">
    <span><%= plugin[:tools].size %> tool<%= "s" unless plugin[:tools].size == 1 %></span>
    <% if integration&.last_used_at %>
      <span class="truncate">• Last used <%= time_ago(integration.last_used_at) %></span>
    <% end %>
  </div>

  <div class="mt-auto flex flex-wrap items-center gap-2 pt-1">
    <%= link_to "Details", plugin_tool_integrations_path(plugin[:key]),
          data: { turbo_frame: "modal" },
          class: "rounded-lg px-2.5 py-1.5 text-[12px] font-medium text-fg-muted transition hover:bg-hover hover:text-fg" %>

    <% if integration %>
      <%= button_to "Enable", toggle_tool_integration_path(integration), method: :post,
            class: "rounded-lg bg-emerald-500/10 px-2.5 py-1.5 text-[12px] font-medium text-emerald-600 transition hover:bg-emerald-500/20 dark:text-emerald-400" unless integration.is_active? %>
      <%= button_to "Disable", toggle_tool_integration_path(integration), method: :post,
            class: "rounded-lg bg-hover px-2.5 py-1.5 text-[12px] font-medium text-fg-muted transition hover:text-fg" if integration.is_active? %>
      <%= link_to "Manage", connect_tool_integrations_path(plugin[:key]), data: { turbo_frame: "modal" }, class: "btn-secondary !px-2.5 !py-1.5 text-[12px]" %>
      <%= button_to "Remove", tool_integration_path(integration), method: :delete,
            form: { data: { turbo_confirm: "Remove the #{plugin[:name]} integration? Its credentials are deleted with it." } },
            class: "rounded-lg px-2.5 py-1.5 text-[12px] font-medium text-red-400 transition hover:bg-red-500/10" %>
    <% elsif plugin[:tools].any? %>
      <%= link_to connect_tool_integrations_path(plugin[:key]), data: { turbo_frame: "modal" }, class: "btn-primary !px-3 !py-1.5 text-[12px]" do %>
        Connect
      <% end %>
    <% else %>
      <%= link_to new_tool_integration_path(provider: plugin[:key]), class: "btn-secondary !px-2.5 !py-1.5 text-[12px]" do %>
        Configure
      <% end %>
    <% end %>
  </div>
</div>
