<%# Phase 4b — Marketplace credential editor rendered into the layout's
    "modal" turbo frame. Serves both first-time connect (POST -> create) and
    Manage (PATCH -> update) from the frozen catalog so the editable fields
    always match what the dispatcher can actually use. Credentials map onto
    the encrypted `credentials` jsonb column and config fields onto `config`.
    Nothing here writes credentials unencrypted. Prefilled from the persisted
    row on update so PATCHing one field doesn't wipe the others. %>
<%= turbo_frame_tag "modal" do %>
  <div data-controller="images-modal"
       class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-8"
       role="dialog" aria-modal="true" aria-label="<%= @connecting ? "Connect" : "Manage" %> <%= @plugin[:name] %>">
    <div class="absolute inset-0 bg-black/50 dark:bg-black/75" data-action="click->images-modal#close"></div>

    <div class="relative flex max-h-full w-full max-w-lg flex-col overflow-hidden rounded-2xl border border-border bg-elevated shadow-2xl">
      <div class="flex items-center justify-between gap-3 border-b border-border px-4 py-3">
        <div class="flex min-w-0 items-center gap-3">
          <div class="grid size-9 shrink-0 place-items-center rounded-xl bg-gradient-to-b from-emerald-400/15 to-emerald-600/15 text-[13px] font-bold text-emerald-600 dark:text-emerald-400">
            <%= @plugin[:name].first(1) %>
          </div>
          <div class="min-w-0">
            <h2 class="truncate text-[14px] font-semibold text-fg">
              <%= @connecting ? "Connect #{@plugin[:name]}" : "Manage #{@plugin[:name]}" %>
            </h2>
            <p class="truncate text-[11.5px] text-fg-subtle"><%= @plugin[:tools].size %> tool<%= "s" unless @plugin[:tools].size == 1 %> become available to your agents</p>
          </div>
        </div>
        <button type="button" data-action="click->images-modal#close"
                class="grid size-9 shrink-0 place-items-center rounded-xl bg-hover text-fg-muted transition hover:text-fg"
                aria-label="Close">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="min-h-0 flex-1 overflow-y-auto p-4">
        <p class="mb-4 text-[12.5px] leading-5 text-fg-muted"><%= @plugin[:description] %></p>

        <%= form_with model: @integration, url: (@connecting ? tool_integrations_path : tool_integration_path(@integration)),
              method: (@connecting ? :post : :patch), data: { turbo_frame: "_top" }, class: "space-y-4" do |f| %>
          <%= f.hidden_field :provider %>

          <div>
            <label class="mb-1 block text-[12.5px] font-medium text-fg-muted" for="tool_integration_name">Display name</label>
            <%= f.text_field :name, class: "input-field", required: true %>
          </div>

          <% creds = @integration.decrypted_credentials.is_a?(Hash) ? @integration.decrypted_credentials : {} %>
          <% @plugin[:credential_fields].each do |field| %>
            <div>
              <label class="mb-1 block text-[12.5px] font-medium text-fg-muted" for="cred-<%= field[:key] %>">
                <%= field[:label] %><%= " (optional)" unless field[:required] %>
              </label>
              <%= tag.input name: "tool_integration[credentials][#{field[:key]}]",
                    id: "cred-#{field[:key]}",
                    type: (field[:type] == "password" ? :password : :text),
                    autocomplete: field[:type] == "password" ? "off" : "on",
                    value: creds[field[:key].to_s],
                    class: "input-field font-mono text-[13px]",
                    required: field[:required],
                    placeholder: field[:hint] %>
              <% if field[:hint].present? %>
                <p class="mt-1 text-[11px] text-fg-subtle"><%= field[:hint] %></p>
              <% end %>
            </div>
          <% end %>

          <% cfg = @integration.config.is_a?(Hash) ? @integration.config : {} %>
          <% Array(@plugin[:config_fields]).each do |field| %>
            <div>
              <label class="mb-1 block text-[12.5px] font-medium text-fg-muted" for="cfg-<%= field[:key] %>">
                <%= field[:label] %><%= " (optional)" unless field[:required] %>
              </label>
              <%= tag.input name: "tool_integration[config][#{field[:key]}]",
                    id: "cfg-#{field[:key]}",
                    type: (field[:type] == "password" ? :password : :text),
                    value: cfg[field[:key].to_s],
                    class: "input-field text-[13px]",
                    required: field[:required],
                    placeholder: field[:hint] %>
              <% if field[:hint].present? %>
                <p class="mt-1 text-[11px] text-fg-subtle"><%= field[:hint] %></p>
              <% end %>
            </div>
          <% end %>

          <% if @plugin[:credential_fields].empty? && Array(@plugin[:config_fields]).empty? %>
            <p class="rounded-xl border border-border bg-panel px-3 py-2.5 text-[12.5px] leading-5 text-fg-muted">
              This plugin needs no credentials — just enable it and its tools become available.
            </p>
          <% end %>

          <p class="text-[11px] leading-4 text-fg-subtle">
            Stored encrypted in your organization's integration record — never in code, never in logs.
          </p>

          <div class="flex justify-end gap-3 pt-1">
            <button type="button" class="btn-secondary" data-action="click->images-modal#close">Cancel</button>
            <%= f.submit (@connecting ? "Connect #{@plugin[:name]}" : "Save changes"), class: "btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
