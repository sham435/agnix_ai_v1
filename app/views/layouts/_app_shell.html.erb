<%#
  Phase 1a — global app shell. Rendered from layouts/application.html.erb via
  `render(layout: "layouts/app_shell") { yield }` for signed-in users, so every
  page inherits the ChatGPT-style grammar: a fixed left sidebar (collapsible to
  an icon-rail on desktop, an off-canvas drawer on mobile) beside a fluid,
  independently-scrolling main column. The block content (the page) is emitted
  by `yield` at the bottom of this file.

  The sidebar is entirely token-driven (bg-sidebar / border-border / text-fg*)
  so it reads correctly in BOTH light and dark themes with no hardcoded
  contrast — the Phase 1 acceptance criterion. Phase 2/3/5 nav slots render only
  once their routes are mounted (AppShell::Features), so no dead links ship.
-%>
<div class="flex h-screen w-full overflow-hidden" data-controller="sidebar theme">
  <%# ── Sidebar ────────────────────────────────────────────────────────── %>
  <aside id="sidebar"
         class="shell-sidebar"
         data-sidebar-target="sidebar"
         data-collapsed="false"
         aria-label="Primary navigation">
    <%# Brand %>
    <div class="flex items-center gap-3 px-4 h-[64px] shrink-0 border-b border-border">
      <div class="relative size-9 grid place-items-center shrink-0">
        <svg viewBox="0 0 100 100" class="size-9 drop-shadow-[0_0_20px_rgba(92,184,112,0.35)]" role="img" aria-label="Shams mark">
          <defs><linearGradient id="shellSun" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#6ee7a0"/><stop offset="100%" stop-color="#5cb870"/>
          </linearGradient></defs>
          <g fill="url(#shellSun)" stroke="url(#shellSun)" stroke-linejoin="round">
            <path d="M50 12 L53.5 32 L65 20 L58 38 L78 35 L62 48 L82 58 L62 62 L72 80 L54 68 L50 88 L46 68 L28 80 L38 62 L18 58 L38 48 L22 35 L42 38 L35 20 L46.5 32 Z"/>
          </g>
        </svg>
      </div>
      <div class="sidebar-label min-w-0">
        <div class="flex items-baseline gap-2">
          <span class="font-semibold text-fg tracking-tight">Shams</span>
          <span class="font-arabic text-accent text-sm font-medium">شمس</span>
        </div>
        <div class="text-[11px] -mt-0.5 text-fg-subtle font-medium tracking-wide">AgentOS · Rails <%= Rails::VERSION::STRING[0, 4] %></div>
      </div>
    </div>

    <%# New chat %>
    <div class="p-3 shrink-0">
      <%= link_to conversations_path,
            class: "sidebar-rail-center relative flex w-full items-center gap-2 rounded-2xl bg-accent px-4 py-3 text-[14px] font-semibold text-accent-fg hover:brightness-110 active:scale-[0.98] transition",
            title: "New chat (⌘⇧O)" do %>
        <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <span class="sidebar-label">New chat</span>
        <kbd class="sidebar-label sidebar-hide-rail absolute right-3 top-1/2 -translate-y-1/2 rounded-md bg-black/15 px-1.5 py-0.5 text-[10px] font-medium">⌘⇧O</kbd>
        <span class="sidebar-tip" aria-hidden="true">New chat</span>
      <% end %>
    </div>

    <%# Nav %>
    <%
      nav = [
        { label: "Chats",        href: conversations_path,           icon: "chat" },
        { label: "Agents",       href: agents_path,                  icon: "agent" },
        { label: "Memories",     href: memories_path,                icon: "memory" },
        { label: "Integrations", href: settings_integrations_path,   icon: "plug" },
      ]
      nav << { label: "Scheduled", href: "/scheduled", icon: "clock" }   if AppShell::Features.enabled?(:scheduled)
      nav << { label: "Images",    href: "/images",    icon: "image" }   if AppShell::Features.enabled?(:images)
      nav << { label: "Explore",   href: "/explore",   icon: "compass" } if AppShell::Features.enabled?(:explore)
      icon = {
        "chat"    => '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
        "agent"   => '<circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83"/>',
        "memory"  => '<path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="9"/>',
        "plug"    => '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><path d="M14 7h3a2 2 0 0 1 2 2v3"/>',
        "clock"   => '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
        "image"   => '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/>',
        "compass" => '<circle cx="12" cy="12" r="9"/><path d="m16 8-2 6-6 2 2-6z"/>'
      }
    %>
    <nav class="shrink-0 px-2 py-1 space-y-0.5">
      <% nav.each do |item| %>
        <%= link_to item[:href],
              class: "sidebar-rail-center shell-nav-item relative #{'shell-nav-active' if sidebar_nav_active?(item[:href])}",
              "aria-current": (sidebar_nav_active?(item[:href]) ? "page" : nil) do %>
          <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-hover">
            <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><%= raw icon[item[:icon]] %></svg>
          </span>
          <span class="sidebar-label"><%= item[:label] %></span>
          <span class="sidebar-tip" aria-hidden="true"><%= item[:label] %></span>
        <% end %>
      <% end %>
    </nav>

    <%# History (recency-grouped) %>
    <div class="flex-1 min-h-0 overflow-y-auto px-2 py-2">
      <% if @sidebar_conversations.present? %>
        <p class="sidebar-label px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-fg-subtle">Recent</p>
        <% group_conversations_by_recency(@sidebar_conversations).each do |label, convs| %>
          <div class="sidebar-label px-3 pt-3 pb-1 text-[11px] font-semibold uppercase tracking-wider text-fg-subtle"><%= label %></div>
          <ul class="space-y-0.5 list-none">
            <% convs.each do |conv| %>
              <% active = request.path == conversation_path(conv) %>
              <li>
                <%= link_to conversation_path(conv),
                      class: "flex items-center gap-2 rounded-lg px-3 py-2 text-[13px] truncate transition #{active ? 'bg-hover text-fg' : 'text-fg-muted hover:bg-hover hover:text-fg'}",
                      title: (conv.title.presence || "Untitled conversation") do %>
                  <span class="size-1.5 shrink-0 rounded-full bg-accent/60" aria-hidden="true"></span>
                  <span class="truncate"><%= conv.title.presence || "Untitled conversation" %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% else %>
        <p class="sidebar-label px-3 py-3 text-[12px] text-fg-subtle">No conversations yet.</p>
      <% end %>
    </div>

    <%# Bottom: user menu + theme toggle %>
    <div class="shrink-0 border-t border-border p-2">
      <div class="flex items-center gap-2">
        <div class="shrink-0"><%= render "shared/user_menu" %></div>
        <div class="sidebar-label min-w-0 flex-1 overflow-hidden">
          <div class="truncate text-[13px] font-medium text-fg"><%= current_user.name %></div>
          <div class="truncate text-[11px] text-fg-subtle"><%= current_user.email %></div>
        </div>
        <button type="button"
                data-theme-target="toggle"
                data-action="click->theme#toggle"
                class="sidebar-rail-center grid size-9 shrink-0 place-items-center rounded-xl bg-hover text-fg-muted hover:text-fg transition"
                aria-label="Switch theme">
          <%# moon shown in light mode (click -> dark); sun shown in dark mode (click -> light) %>
          <svg data-theme-moon class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg data-theme-sun class="hidden size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <button type="button"
                data-sidebar-target="collapse"
                data-action="click->sidebar#toggleCollapse"
                class="hidden lg:grid size-9 shrink-0 place-items-center rounded-xl bg-hover text-fg-subtle hover:text-fg transition"
                aria-label="Collapse sidebar"
                aria-pressed="false">
          <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>
        </button>
      </div>
    </div>
  </aside>

  <%# Mobile drawer backdrop %>
  <div id="overlay"
       class="shell-overlay"
       data-sidebar-target="overlay"
       data-action="click->sidebar#closeDrawer"
       data-open="false"></div>

  <%# ── Main column (the page) ─────────────────────────────────────────── %>
  <div class="flex flex-1 flex-col min-w-0 bg-canvas">
    <%= yield %>
  </div>
</div>
