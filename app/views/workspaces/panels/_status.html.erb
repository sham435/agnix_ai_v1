<%#
  What the sandbox actually is right now, as the manager last confirmed it —
  plus the two things that leave the sandbox: a ZIP of the volume, and the
  destroy call that removes the container and its volume.
-%>
<%
  state = (status.presence || {}).dig("state") || workspace.state
  badge = { "ready" => "bg-emerald-500/15 text-emerald-600 border-emerald-500/30",
            "running" => "bg-emerald-500/15 text-emerald-600 border-emerald-500/30" }.fetch(state,
            "bg-hover text-fg-muted border-border-subtle")
%>
<div class="card space-y-3">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="truncate text-[14px] font-semibold text-fg"><%= workspace.name %></p>
      <p class="mt-0.5 truncate font-mono text-[11px] text-fg-subtle">
        <%= workspace.runtime %> · <%= workspace.id.first(8) %>
      </p>
    </div>
    <span class="shrink-0 rounded-full border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide <%= badge %>">
      <%= state %>
    </span>
  </div>

  <% if (detail = (status.presence || {})["error"] || workspace.last_error).present? %>
    <p class="text-[12px] text-fg-muted"><%= detail %></p>
  <% end %>

  <% if (limits = (status.presence || {})["limits"]).present? %>
    <p class="font-mono text-[11px] text-fg-subtle">
      <%= limits["cpus"] %> CPU · <%= limits["memory_mb"] %> MB · network off
    </p>
  <% end %>

  <div class="flex flex-wrap gap-2">
    <%= link_to "Download ZIP", workspace_export_path(workspace),
          class: "btn-secondary text-[12px]", data: { turbo: "false" } %>
    <%= button_to "Stop workspace", workspace_path(workspace), method: :delete,
          class: "btn-secondary text-[12px] text-red-600",
          form: { data: { turbo_frame: "workspace_panel_body" } },
          data: { turbo_confirm: "This deletes the container and its files. Export a ZIP first." } %>
  </div>
</div>
