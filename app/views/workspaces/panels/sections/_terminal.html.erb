<%#
  Run something yourself. The field is split into argv tokens on the server and
  each token is handed to the container as its own argument — there is no shell
  in this path, so a quoted name with spaces arrives intact and a semicolon
  stays exactly the character it is.
-%>
<div class="card space-y-3">
  <p class="text-[12px] font-semibold uppercase tracking-wide text-fg-subtle">Terminal</p>

  <%= form_with url: workspace_exec_path(workspace), method: :post,
        class: "grid grid-cols-[1fr_84px_auto] gap-2",
        data: { turbo_frame: "workspace_panel_body" } do |f| %>
    <%= f.text_field :command, value: "python3 -V",
          class: "min-w-0 rounded-lg border border-border bg-canvas px-2 py-1.5 font-mono text-[12px] text-fg",
          aria: { label: "Command to run in the workspace" } %>
    <%= f.number_field :timeout, value: 30, min: 1, max: 300,
          class: "rounded-lg border border-border bg-canvas px-2 py-1.5 text-[12px] text-fg",
          aria: { label: "Timeout in seconds" } %>
    <%= f.submit "Run", class: "btn-primary cursor-pointer px-3 text-[12px]" %>
  <% end %>

  <% if @runs.blank? %>
    <p class="text-[12px] text-fg-subtle">Nothing has run in this workspace yet.</p>
  <% else %>
    <div class="space-y-2">
      <% @runs.each do |run| %>
        <%= render "workspaces/panels/run", run: run, show_argv: true %>
      <% end %>
    </div>
  <% end %>
</div>
