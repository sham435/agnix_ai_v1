<%= render "layouts/chat_layout" do %>
  <header class="sticky top-0 z-20 flex h-[64px] items-center justify-between gap-3 border-b border-border-subtle bg-sidebar/80 glass px-4">
    <%= link_to organization_path(@organization), class: "flex items-center gap-2 text-fg-muted hover:text-fg transition" do %>
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      <span class="text-[14px]">Back</span>
    <% end %>
    <h1 class="text-[16px] font-semibold text-fg">Members</h1>
    <div></div>
  </header>

  <main class="flex-1 overflow-y-auto p-6">
    <div class="mx-auto max-w-[700px] space-y-6">
      <!-- Add member -->
      <div class="card">
        <h2 class="text-[15px] font-medium text-fg mb-3">Add Member</h2>
        <%= form_with url: organization_memberships_path(@organization), class: "flex gap-3", data: { turbo: false } do |f| %>
          <%= f.email_field :email, placeholder: "teammate@example.com", class: "input-field flex-1", required: true %>
          <%= f.select :role, Membership.roles.map { |name, val| [name.titleize, val] }, {}, class: "input-field w-[140px]" %>
          <%= f.submit "Add", class: "btn-primary" %>
        <% end %>
      </div>

      <!-- List -->
      <div class="card">
        <h2 class="text-[15px] font-medium text-fg mb-3"><%= pluralize(@memberships.size, "Member") %></h2>
        <div class="space-y-2">
          <% @memberships.each do |membership| %>
            <div class="flex items-center justify-between rounded-lg bg-hover px-3 py-2.5 text-[13px]">
              <div class="flex items-center gap-3">
                <div class="size-8 rounded-lg bg-hover grid place-items-center text-fg-muted">
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>
                </div>
                <div>
                  <div class="text-fg"><%= membership.user.name %></div>
                  <div class="text-[11px] text-fg-subtle"><%= membership.user.email %></div>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <%= form_with url: organization_membership_path(@organization, membership), method: :patch, class: "inline-flex", data: { turbo: false } do |f| %>
                  <%# Saves itself on change. Not with an inline `onchange=` attribute:
                      this app's CSP carries a script-src nonce, which voids
                      'unsafe-inline' for event handler attributes as well, so the
                      inline handler never runs. The action lives in Stimulus. %>
                  <%= f.select :role, Membership.roles.map { |name, val| [name.titleize, val] }, { selected: membership.role }, class: "input-field", data: { controller: "auto-submit", action: "change->auto-submit#submit" } %>
                <% end %>
                <% unless membership.owner? %>
                  <%= button_to "Remove", organization_membership_path(@organization, membership), method: :delete, class: "text-fg-subtle hover:text-red-600 dark:hover:text-red-400 transition", data: { turbo: false } %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </main>

  <%= render "shared/sidebar_js" %>
<% end %>