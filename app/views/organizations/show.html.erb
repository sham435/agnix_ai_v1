<%= render "layouts/chat_layout" do %>
  <header class="sticky top-0 z-20 flex h-[64px] items-center justify-between gap-3 border-b border-border-subtle bg-sidebar/80 glass px-4">
    <%= link_to organizations_path, class: "flex items-center gap-2 text-fg-muted hover:text-fg transition" do %>
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      <span class="text-[14px]">Back to Organizations</span>
    <% end %>
    <h1 class="text-[16px] font-semibold text-fg"><%= @organization.name %></h1>
    <% if current_user&.admin?(@organization) %>
      <div class="flex items-center gap-2">
        <%= link_to edit_organization_path(@organization), class: "btn-secondary text-[13px]" do %>
          Edit
        <% end %>
      </div>
    <% else %>
      <div></div>
    <% end %>
  </header>

  <main class="flex-1 overflow-y-auto p-6">
    <div class="mx-auto max-w-[900px] space-y-6">
      <!-- Overview -->
      <div class="card">
        <h2 class="text-[15px] font-medium text-fg mb-4">Overview</h2>
        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-[13px]">
          <div class="rounded-xl bg-hover px-4 py-3">
            <dt class="text-fg-subtle">Plan</dt>
            <dd class="text-fg font-medium capitalize mt-1"><%= @organization.plan %></dd>
          </div>
          <div class="rounded-xl bg-hover px-4 py-3">
            <dt class="text-fg-subtle">Members</dt>
            <dd class="text-fg font-medium mt-1"><%= @organization.user_count %></dd>
          </div>
          <div class="rounded-xl bg-hover px-4 py-3">
            <dt class="text-fg-subtle">Agents</dt>
            <dd class="text-fg font-medium mt-1"><%= @agents.size %></dd>
          </div>
          <div class="rounded-xl bg-hover px-4 py-3">
            <dt class="text-fg-subtle">Conversations</dt>
            <dd class="text-fg font-medium mt-1"><%= @organization.conversations_count %></dd>
          </div>
        </dl>
      </div>

      <!-- Members -->
      <div class="card">
        <h2 class="text-[15px] font-medium text-fg mb-3">Members</h2>
        <div class="space-y-2">
          <% @members.each do |membership| %>
            <div class="flex items-center justify-between rounded-lg bg-hover px-3 py-2.5 text-[13px]">
              <div class="flex items-center gap-3">
                <div class="size-8 rounded-lg bg-hover grid place-items-center text-fg-muted">
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>
                </div>
                <div>
                  <div class="text-fg"><%= membership.user.name %></div>
                  <div class="text-[11px] text-fg-subtle"><%= membership.user.email %></div>
                </div>
              </div>
              <%= status_badge(membership.role) %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Agents -->
      <% if @agents.any? %>
        <div class="card">
          <h2 class="text-[15px] font-medium text-fg mb-3">Agents</h2>
          <div class="space-y-2">
            <% @agents.each do |agent| %>
              <%= link_to agent_path(agent), class: "flex items-center justify-between rounded-lg bg-panel px-3 py-2.5 text-[13px] hover:bg-hover transition" do %>
                <div class="flex items-center gap-3">
                  <span class="size-8 rounded-lg bg-accent/10 grid place-items-center text-accent-text">
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4"/></svg>
                  </span>
                  <span class="text-fg"><%= agent.name %></span>
                </div>
                <span class="text-fg-subtle"><%= agent.model %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </main>

  <%= render "shared/sidebar_js" %>
<% end %>