<%= render "layouts/chat_layout" do %>
  <header class="sticky top-0 z-20 flex h-[64px] items-center justify-between gap-3 border-b border-border-subtle bg-sidebar/80 glass px-4">
    <%= link_to organization_agent_path(@agent.organization, @agent), class: "flex items-center gap-2 text-fg-muted hover:text-fg transition" do %>
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
    <% end %>
    <div class="flex items-center gap-2">
      <span class="size-6 rounded-lg bg-accent/10 grid place-items-center text-accent-text">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4"/></svg>
      </span>
      <span class="text-[14px] font-medium text-fg"><%= @agent.name %> — Test Playground</span>
    </div>
    <div></div>
  </header>

  <main class="flex-1 overflow-y-auto p-6" data-controller="playground">
    <div class="mx-auto max-w-[700px] space-y-6">
      <!-- Config -->
      <div class="card">
        <h2 class="text-[15px] font-medium text-fg mb-3">Agent Config</h2>
        <dl class="grid grid-cols-3 gap-4 text-[13px]">
          <div>
            <dt class="text-fg-subtle">Provider</dt>
            <dd class="text-fg font-medium"><%= @agent.provider.titleize %></dd>
          </div>
          <div>
            <dt class="text-fg-subtle">Model</dt>
            <dd class="text-fg font-medium font-mono text-[12px]"><%= @agent.model %></dd>
          </div>
          <div>
            <dt class="text-fg-subtle">Tools</dt>
            <dd class="text-fg font-medium"><%= @agent.tools.inspect %></dd>
          </div>
        </dl>
      </div>

      <!-- Test form -->
      <div class="card">
        <h2 class="text-[15px] font-medium text-fg mb-3">Send Test Message</h2>
        <%= form_with url: test_organization_agent_path(@agent.organization, @agent), method: :post, class: "flex gap-3", data: { turbo: false } do |f| %>
          <%= f.text_area :message, rows: 2, placeholder: "Say something to test this agent...", class: "input-field flex-1 resize-none", id: "test_message" %>
          <%= f.submit "Run", class: "btn-primary h-fit", id: "test_run_btn" %>
        <% end %>
        <div id="test-result" class="hidden mt-4 rounded-lg bg-hover border border-border-subtle p-4 text-[13px] text-fg font-mono whitespace-pre-wrap"></div>
      </div>

      <!-- Quick tips -->
      <div class="card">
        <h2 class="text-[15px] font-medium text-fg mb-3">Tips</h2>
        <ul class="space-y-2 text-[13px] text-fg-muted">
          <li>• System prompt: <%= @agent.system_prompt.to_s.truncate(120) %></li>
          <li>• Each test creates a conversation record. Refresh recent runs below.</li>
        </ul>
      </div>
    </div>
  </main>

  <%= render "shared/sidebar_js" %>
<% end %>