<%= render "layouts/chat_layout" do %>
  <header class="sticky top-0 z-20 flex h-[64px] items-center justify-between gap-3 border-b border-border-subtle bg-sidebar/80 glass px-4">
    <%= link_to organization_agent_path(@agent.organization, @agent), class: "flex items-center gap-2 text-fg-muted hover:text-fg transition" do %>
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
    <% end %>
    <div class="flex items-center gap-2">
      <span class="size-6 rounded-lg bg-accent/10 grid place-items-center text-accent-text">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4"/></svg>
      </span>
      <span class="text-[14px] font-medium text-fg"><%= @agent.name %> Conversations</span>
    </div>
    <div></div>
  </header>

  <main class="flex-1 overflow-y-auto p-6">
    <div class="mx-auto max-w-[700px]">
      <% if @conversations.any? %>
        <div class="space-y-2">
          <% @conversations.each do |conv| %>
            <%= link_to conversation_path(conv), class: "flex items-center justify-between rounded-2xl bg-panel border border-border-subtle px-4 py-3 hover:bg-hover transition" do %>
              <div class="flex items-center gap-3 min-w-0">
                <span class="size-8 rounded-lg bg-hover grid place-items-center text-fg-muted shrink-0">
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                </span>
                <span class="text-[13px] text-fg truncate"><%= conv.title || "Untitled conversation" %></span>
              </div>
              <span class="text-[12px] text-fg-subtle shrink-0 ml-3"><%= time_ago(conv.updated_at) %></span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-20">
          <h2 class="text-lg font-semibold text-fg mb-2">No conversations yet</h2>
          <p class="text-fg-subtle">Start a chat with this agent from the main conversation view.</p>
        </div>
      <% end %>
    </div>
  </main>

  <%= render "shared/sidebar_js" %>
<% end %>