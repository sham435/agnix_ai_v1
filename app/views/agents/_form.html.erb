<%= form_with model: agent, class: "space-y-6",
  data: { controller: "provider-models", provider_models_models_value: Agent::MODELS } do |f| %>
  <div class="card space-y-6">
    <h2 class="text-[15px] font-medium text-white">Basic Info</h2>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-[13px] font-medium text-zinc-300 mb-1">Name</label>
        <%= f.text_field :name, placeholder: "My Agent", class: "input-field", required: true %>
      </div>
      <div>
        <label class="block text-[13px] font-medium text-zinc-300 mb-1">Slug</label>
        <%= f.text_field :slug, placeholder: "my-agent", class: "input-field" %>
        <p class="text-[11px] text-zinc-600 mt-1">Auto-generated from name</p>
      </div>
    </div>

    <div>
      <label class="block text-[13px] font-medium text-zinc-300 mb-1">Description</label>
      <%= f.text_area :description, rows: 2, placeholder: "What does this agent do?", class: "input-field resize-none" %>
    </div>
  </div>

  <div class="card space-y-6">
    <h2 class="text-[15px] font-medium text-white">Model & Provider</h2>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-[13px] font-medium text-zinc-300 mb-1">Provider</label>
        <%= f.select :provider, Agent::MODELS.keys.map { |key| [key.to_s.titleize, key.to_s] },
              {}, class: "input-field",
              data: { provider_models_target: "provider", action: "change->provider-models#sync" } %>
      </div>
      <div>
        <label class="block text-[13px] font-medium text-zinc-300 mb-1">Model</label>
        <%= f.select :model, agent.model_select_options, {}, class: "input-field",
              data: { provider_models_target: "model" } %>
        <p class="text-[11px] text-zinc-600 mt-1">Filtered by provider. A model already saved on this agent stays listed even if the catalog no longer offers it.</p>
      </div>
    </div>

    <div>
      <label class="block text-[13px] font-medium text-zinc-300 mb-1">System Prompt</label>
      <%= f.text_area :system_prompt, rows: 8,
        placeholder: "You are a helpful AI assistant...",
        class: "input-field resize-none font-mono text-[13px]" %>
    </div>
  </div>

  <div class="card space-y-6">
    <h2 class="text-[15px] font-medium text-white">Tools</h2>
    <%# Sentinel keeps agent[tools][] present when nothing is checked, so
        unchecking everything genuinely clears the built-in selection. The
        blank entry is dropped by the controller's sanitizer. %>
    <%= hidden_field_tag "agent[tools][]", "" %>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
      <% Agents::ToolRegistry.all.each do |tool| %>
        <label class="flex items-center gap-2 rounded-xl bg-white/[0.04] px-3 py-2.5 hover:bg-white/[0.06] cursor-pointer transition">
              <%= check_box_tag "agent[tools][]", tool[:name], agent.persisted? ? (agent.tools.include?(tool[:name]) || agent.tools.any? { |t| t.is_a?(Hash) && t["name"] == tool[:name] }) : true, class: "rounded border-zinc-600 bg-white/[0.04] text-emerald-500 focus:ring-emerald-500/20" %>
          <span class="text-[13px] text-zinc-300"><%= tool[:name].titleize %></span>
        </label>
      <% end %>
    </div>

    <% plugin_entries = Tools::Catalog.available_plugins(agent.organization) %>
    <% if plugin_entries.any? %>
      <div class="pt-1 border-t border-white/[0.06] space-y-3">
        <div>
          <h3 class="text-[12px] font-medium uppercase tracking-wider text-zinc-500">Plugin tools</h3>
          <p class="text-[11px] text-zinc-600 mt-1">From your connected plugins. Selections store the plugin binding alongside the tool name.</p>
        </div>
        <%= hidden_field_tag "agent[plugin_tools][]", "" %>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          <% plugin_entries.each do |entry| %>
            <% plugin = entry[:plugin] %>
            <% plugin[:tools].each do |tool| %>
              <% namespaced = Tools::Catalog.namespaced(plugin[:key], tool[:name]) %>
              <% selected = agent.tools.any? { |t| (t.is_a?(Hash) ? t["name"] : t) == namespaced } %>
              <label class="flex items-center gap-2 rounded-xl bg-white/[0.04] px-3 py-2.5 hover:bg-white/[0.06] cursor-pointer transition" title="<%= tool[:summary] %>">
                <%= check_box_tag "agent[plugin_tools][]", namespaced, selected, class: "rounded border-zinc-600 bg-white/[0.04] text-emerald-500 focus:ring-emerald-500/20" %>
                <span class="text-[13px] text-zinc-300"><%= tool[:name].titleize %></span>
                <span class="text-[11px] text-zinc-600"><%= plugin[:name] %></span>
              </label>
            <% end %>
          <% end %>
        </div>
      </div>
    <% elsif current_organization&.tool_integrations&.any? %>
      <p class="text-[11px] text-zinc-600">No connected plugin currently exposes agent tools. Enable one on the
        <%= link_to "Plugins", tool_integrations_path, class: "text-emerald-400 hover:underline" %> page.</p>
    <% end %>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancel", agents_path, class: "btn-secondary" %>
    <%= f.submit submit_label, class: "btn-primary" %>
  </div>
<% end %>
